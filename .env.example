# Backend origin. No trailing slash.
VITE_API_BASE_URL=http://localhost:8000

# Optional: a published contour id (Burchmulla, decision #45) the tariff
# calculator (A3) prices against, since `POST /calculations/preview` always
# requires one and A3 has no contour-picking UI of its own (that is B7's
# job, in the adminka wizard). Left empty, the calculator stays in its
# explanatory "estimate unavailable" state instead of guessing a contour.
VITE_DEMO_CONTOUR_ID=
